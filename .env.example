NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/office
DATABASE_SSL=false
DB_POOL_MAX=10
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
APP_TIMEZONE=Asia/Jerusalem
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@office.local
