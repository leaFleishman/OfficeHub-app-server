{
  "openapi": "3.0.3",
  "info": {
    "title": "Office Server API",
    "version": "1.0.0",
    "description": "API documentation for the Office Server."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 1 }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "schema": { "type": "string", "maxLength": 100 }
      },
      "InquiryStatus": {
        "name": "status",
        "in": "query",
        "schema": { "type": "string", "enum": ["Open", "InProgress", "Closed", "All"] }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "password": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "phone": { "type": "string", "maxLength": 30, "nullable": true },
          "address": { "type": "string", "minLength": 1, "maxLength": 250, "nullable": true }
        }
      },
      "PasswordChange": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string", "minLength": 1, "maxLength": 200 },
          "newPassword": { "type": "string", "minLength": 4, "maxLength": 72 }
        }
      },
      "RoomCreate": {
        "type": "object",
        "required": ["name", "capacity"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 500 },
          "floor": { "type": "integer", "minimum": -5, "maximum": 200 },
          "equipment": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 50 }
          }
        }
      },
      "RoomUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "capacity": { "type": "integer", "minimum": 1, "maximum": 500 },
          "floor": { "type": "integer", "minimum": -5, "maximum": 200 },
          "equipment": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 50 }
          }
        }
      },
      "BookingCreate": {
        "type": "object",
        "required": ["roomId", "subject", "date", "startTime", "endTime"],
        "properties": {
          "roomId": { "type": "integer", "minimum": 1 },
          "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
          "date": { "type": "string", "format": "date", "example": "2027-12-03" },
          "startTime": { "type": "string", "format": "time", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$", "example": "09:00" },
          "endTime": { "type": "string", "format": "time", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$", "example": "11:30" },
          "participantIds": {
            "type": "array",
            "maxItems": 500,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      },
      "BookingResponse": {
        "type": "object",
        "required": ["id", "roomId", "roomName", "userId", "date", "startTime", "endTime", "status", "createdAt", "participants"],
        "properties": {
          "id": { "type": "integer" },
          "roomId": { "type": "integer" },
          "roomName": { "type": "string" },
          "userId": { "type": "integer" },
          "userName": { "type": "string", "nullable": true },
          "subject": { "type": "string", "nullable": true },
          "date": { "type": "string", "format": "date", "example": "2027-12-03" },
          "startTime": { "type": "string", "format": "time", "example": "09:00" },
          "endTime": { "type": "string", "format": "time", "example": "11:30" },
          "status": { "type": "string", "enum": ["Active", "Cancelled"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" }
              }
            }
          }
        }
      },
      "CompanyCreate": {
        "type": "object",
        "required": ["name", "manager"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "floor": { "type": "integer", "minimum": -5, "maximum": 200, "nullable": true },
          "phone": { "type": "string", "maxLength": 30, "nullable": true },
          "manager": {
            "type": "object",
            "required": ["name", "email", "password"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 100 },
              "email": { "type": "string", "format": "email", "maxLength": 254 },
              "password": { "type": "string", "minLength": 4, "maxLength": 72 }
            }
          }
        }
      },
      "CompanyUpdate": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "floor": { "type": "integer", "minimum": -5, "maximum": 200, "nullable": true },
          "phone": { "type": "string", "maxLength": 30, "nullable": true }
        }
      },
      "EmployeeCreate": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "phone": { "type": "string", "maxLength": 30 },
          "password": { "type": "string", "minLength": 4, "maxLength": 72 },
          "role": { "type": "string", "enum": ["Employee", "Manager"], "default": "Employee" },
          "companyId": { "type": "integer", "minimum": 1 }
        }
      },
      "EmployeeRole": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string", "enum": ["Employee", "Manager"] }
        }
      },
      "InquiryCreate": {
        "type": "object",
        "required": ["subject", "content"],
        "properties": {
          "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
          "content": { "type": "string", "minLength": 1, "maxLength": 5000 }
        }
      },
      "InquiryHandle": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["InProgress", "Closed"] },
          "reply": { "type": "string", "maxLength": 5000 }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Service root",
        "security": [],
        "responses": {
          "200": {
            "description": "Service metadata",
            "content": {
              "application/json": {
                "example": {
                  "service": "office-server",
                  "status": "running",
                  "api": "/api",
                  "health": "/health"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": { "description": "Service is healthy" },
          "503": { "description": "Database unavailable" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated; returns a JWT and user details" },
          "400": {
            "description": "Invalid credentials or request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get current authenticated user",
        "responses": {
          "200": { "description": "Current user" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": ["Profile"],
        "summary": "Get profile",
        "responses": {
          "200": { "description": "Profile returned" },
          "401": { "description": "Unauthorized" }
        }
      },
      "put": {
        "tags": ["Profile"],
        "summary": "Update profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Profile updated" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/profile/password": {
      "put": {
        "tags": ["Profile"],
        "summary": "Change password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordChange" }
            }
          }
        },
        "responses": {
          "204": { "description": "Password changed" },
          "400": { "description": "Invalid request or current password" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/rooms": {
      "get": {
        "tags": ["Rooms"],
        "summary": "List rooms",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/Search" }
        ],
        "responses": {
          "200": { "description": "Rooms list" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["Rooms"],
        "summary": "Create room (Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RoomCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Room created" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/rooms/available": {
      "get": {
        "tags": ["Rooms"],
        "summary": "List available rooms",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "minCapacity",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1 }
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "description": "Available rooms" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/rooms/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Rooms"],
        "summary": "Get room",
        "responses": {
          "200": { "description": "Room details" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Room not found" }
        }
      },
      "put": {
        "tags": ["Rooms"],
        "summary": "Update room (Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RoomUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Room updated" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      },
      "delete": {
        "tags": ["Rooms"],
        "summary": "Delete room (Admin)",
        "responses": {
          "204": { "description": "Room deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/rooms/{id}/bookings": {
      "get": {
        "tags": ["Rooms", "Bookings"],
        "summary": "List bookings for a room",
        "parameters": [
          { "$ref": "#/components/parameters/Id" },
          {
            "name": "date",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": {
            "description": "Bookings for the room",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/BookingResponse" }
                    },
                    "total": { "type": "integer" },
                    "page": { "type": "integer" },
                    "pageSize": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/bookings/all": {
      "get": {
        "tags": ["Bookings"],
        "summary": "List active bookings across all companies (Admin only)",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "description": "Active bookings across all companies" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/bookings/company": {
      "get": {
        "tags": ["Bookings"],
        "summary": "List all bookings for a company (Manager or Admin)",
        "description": "Managers see their own company's bookings. Admins must provide companyId.",
        "parameters": [
          { "name": "companyId", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "description": "All bookings, including cancelled bookings, for the selected company" },
          "400": { "description": "companyId is required for Admin" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "tags": ["Bookings"],
        "summary": "List bookings (Manager or Admin)",
        "parameters": [
          { "name": "employeeId", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "roomId", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "companyId", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": {
            "description": "Bookings list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/BookingResponse" }
                    },
                    "total": { "type": "integer" },
                    "page": { "type": "integer" },
                    "pageSize": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      },
      "post": {
        "tags": ["Bookings"],
        "summary": "Create booking (Employee or Manager)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BookingCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BookingResponse" }
              }
            }
          },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/bookings/mine": {
      "get": {
        "tags": ["Bookings"],
        "summary": "List my bookings (Employee or Manager)",
        "parameters": [
          {
            "name": "upcoming",
            "in": "query",
            "schema": { "type": "boolean", "default": false }
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": {
            "description": "Current user's bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/BookingResponse" }
                    },
                    "total": { "type": "integer" },
                    "page": { "type": "integer" },
                    "pageSize": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/bookings/{id}": {
      "delete": {
        "tags": ["Bookings"],
        "summary": "Cancel booking (owner or Admin)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "204": { "description": "Booking cancelled" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Booking not found" }
        }
      }
    },
    "/api/employees": {
      "get": {
        "tags": ["Employees"],
        "summary": "List employees (Manager or Admin)",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/Search" },
          { "name": "companyId", "in": "query", "schema": { "type": "integer", "minimum": 1 } }
        ],
        "responses": {
          "200": { "description": "Employees list" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      },
      "post": {
        "tags": ["Employees"],
        "summary": "Create employee (Manager or Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmployeeCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Employee created" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/employees/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Employees"],
        "summary": "Get employee (Manager or Admin)",
        "responses": {
          "200": { "description": "Employee details" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Employee not found" }
        }
      },
      "put": {
        "tags": ["Employees"],
        "summary": "Update employee (Manager or Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileUpdate" }
            }
          }
        },
        "responses": {
          "200": { "description": "Employee updated" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Employee not found" }
        }
      }
    },
    "/api/employees/{id}/block": {
      "patch": {
        "tags": ["Employees"],
        "summary": "Block employee (Manager or Admin)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Employee blocked" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/employees/{id}/unblock": {
      "patch": {
        "tags": ["Employees"],
        "summary": "Unblock employee (Manager or Admin)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Employee unblocked" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/employees/{id}/role": {
      "patch": {
        "tags": ["Employees"],
        "summary": "Change employee role (Manager or Admin)",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmployeeRole" }
            }
          }
        },
        "responses": {
          "200": { "description": "Employee role updated" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/companies": {
      "get": {
        "tags": ["Companies"],
        "summary": "List companies (Admin)",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/Search" }
        ],
        "responses": {
          "200": { "description": "Companies list" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      },
      "post": {
        "tags": ["Companies"],
        "summary": "Create company (Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CompanyCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Company created" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/companies/mine": {
      "get": {
        "tags": ["Companies"],
        "summary": "Get my company (Manager or linked Admin)",
