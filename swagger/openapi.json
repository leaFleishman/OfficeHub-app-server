    "/api/dashboard/employee": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Employee dashboard (Employee)",
        "responses": {
          "200": {
            "description": "Employee dashboard data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nextMeeting": {
                      "allOf": [{ "$ref": "#/components/schemas/BookingResponse" }],
                      "nullable": true
                    },
                    "meetingsThisWeek": { "type": "integer" },
                    "upcomingMeetings": { "type": "integer", "description": "Active meetings scheduled to start in the future" },
                    "openInquiries": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/dashboard/company": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Company dashboard (Employee or Manager; Admin sees all companies)",
        "responses": {
          "200": {
            "description": "Company dashboard data, including the next active meeting or null",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nextMeeting": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "subject": { "type": "string" },
                        "date": { "type": "string", "format": "date" },
                        "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                        "roomName": { "type": "string" }
                      },
                      "required": ["subject", "date", "startTime", "roomName"]
                    },
                    "employees": {
                      "type": "object",
                      "properties": {
                        "active": { "type": "integer" },
                        "blocked": { "type": "integer" }
                      }
                    },
                    "meetingsThisWeek": { "type": "integer" },
                    "topRooms": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "roomName": { "type": "string" },
                          "bookings": { "type": "integer" }
                        }
                      }
                    },
                    "recentEmployees": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "name": { "type": "string" },
                          "joinedAt": { "type": "string", "format": "date-time" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/dashboard/building": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Building dashboard (Admin)",
        "responses": {
          "200": { "description": "Building dashboard data" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    }
  }
